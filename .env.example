# Pylot environment — copy to .env.local and fill in. .env* is gitignored.

# The teacher's Anthropic API key (Phase 2). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Teacher model as a "provider/model" string (config, not code — ADR-005).
# "anthropic/..." + ANTHROPIC_API_KEY → direct Anthropic provider;
# any other string routes through the Vercel AI Gateway (AI_GATEWAY_API_KEY).
PYLOT_TEACHER_MODEL=anthropic/claude-sonnet-5

# Hard monthly spend cap in USD (owner decision 2026-07-04). The teacher
# endpoint refuses calls once the ai_usage ledger for the current UTC month
# reaches this. Optional price overrides for cost math:
#   PYLOT_TEACHER_USD_PER_MTOK_IN / PYLOT_TEACHER_USD_PER_MTOK_OUT
PYLOT_TEACHER_SPEND_CAP_USD=10

# Overrides used by verify scripts (never set these for normal dev):
# PYLOT_DB_PATH=      # scratch DB for automated runs
# PYLOT_DIST_DIR=     # separate .next dir so verify coexists with `npm run dev`
